  id: string;
  grade: Grade;
  subject: Subject;
  skill: string;
  title: string;
  prompt: string;
  choices: string[];
  answer: string;
  hint: string;
  explanation: string;
};

export type ActivityAttempt = {
  id: string;
  questionId: string;
  subject: Subject;
  answer: string;
  isCorrect: boolean;
  usedHint: boolean;
  completedAt: string;
};

